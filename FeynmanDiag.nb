Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "0."}]}], " ", "LISP", " ", 
     RowBox[{"INTERFACE", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EvaluateModel", "[", "lispCommand_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "scriptPath", ",", "sbclPath", ",", "processResult", ",", "rawOutput", 
        ",", "cleanString", ",", "data"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"1.", " ", "PATH", " ", "CONFIGURATION"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
       "Update", " ", "these", " ", "paths", " ", "to", " ", "match", " ", 
        "your", " ", "system"}], "*)"}], 
      RowBox[{
       RowBox[{
       "scriptPath", "=", 
        "\"\</Users/zjitu/Documents/Lisp/NLSM/nlsm.lisp\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sbclPath", "=", "\"\</opt/homebrew/bin/sbcl\>\""}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"2.", " ", "EXECUTE", " ", "LISP", " ", 
         RowBox[{"(", "Corrected", ")"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "We", " ", "do", " ", "NOT", " ", "ask", " ", "for", " ", 
          "\"\<StandardOutput\>\"", " ", "here"}], ",", 
         RowBox[{
         "so", " ", "we", " ", "get", " ", "the", " ", "full", " ", "status", 
          " ", "object"}]}], "*)"}], 
       RowBox[{"processResult", "=", 
        RowBox[{"RunProcess", "[", 
         RowBox[{"{", 
          RowBox[{
          "sbclPath", ",", "\"\<--script\>\"", ",", "scriptPath", ",", 
           "lispCommand"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"3.", " ", "ERROR", " ", "CHECKING"}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"processResult", "[", "\"\<ExitCode\>\"", "]"}], "=!=", 
          "0"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<Lisp Script Failed!\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"processResult", "[", "\"\<StandardError\>\"", "]"}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rawOutput", "=", 
        RowBox[{"processResult", "[", "\"\<StandardOutput\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "SMART", " ", "EXTRACTION"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Extracts", " ", "only", " ", "the", " ", "Association", " ", 
          RowBox[{"<|", "...", "|>"}]}], ",", 
         RowBox[{"ignoring", " ", "NILs", " ", "or", " ", "warnings"}]}], 
        "*)"}], 
       RowBox[{"cleanString", "=", 
        RowBox[{"First", "[", 
         RowBox[{
          RowBox[{"StringCases", "[", 
           RowBox[{"rawOutput", ",", 
            RowBox[{"\"\<<|\>\"", "~~", "___", "~~", "\"\<|>\>\""}]}], "]"}], 
          ",", "\"\<\>\""}], " ", 
         RowBox[{"(*", "Fallback", "*)"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"cleanString", "===", "\"\<\>\""}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<Extraction Failed. No valid Association found in output.\>\"",
            "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Raw Output: \>\"", ",", "rawOutput"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"5.", " ", "CONVERT", " ", "TO", " ", "CODE"}], "*)"}], 
       RowBox[{"data", "=", 
        RowBox[{"ToExpression", "[", "cleanString", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "data", "]"}], ";"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[1652]:=",ExpressionUUID->"93bd7eda-44b4-427f-8226-c70bdd5cec22"],

